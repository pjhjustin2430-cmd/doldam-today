# 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# (선택) 네이버 지도 — NCP 콘솔 > Maps > Application 의 Client ID. 없으면 직접 그린 SVG 지도로 보여줘요
VITE_NAVER_MAP_CLIENT_ID=

# 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=
